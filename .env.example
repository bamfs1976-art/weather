# Vaisala Xweather API credentials.
# Create a free application at https://account.xweather.com/ to get an ID/secret pair.
# These are read server-side only and never reach the browser.
XWEATHER_CLIENT_ID=your_client_id_here
XWEATHER_CLIENT_SECRET=your_client_secret_here

# Tide times (UKHO ADMIRALTY UK Tidal API) — optional.
# The "Discovery" tier is free: https://admiraltyapi.portal.azure-api.net/
# Without it the Rivers & Tides tab still shows river levels and flood warnings.
ADMIRALTY_API_KEY=your_admiralty_subscription_key_here

# Football fixtures (football-data.org) — optional.
# Free tier: https://www.football-data.org/client/register
FOOTBALL_DATA_TOKEN=your_football_data_token_here
# Club to follow, and the competition code it plays in (default ELC = Championship).
# If the club changes division, update FOOTBALL_COMPETITION.
FOOTBALL_TEAM=Swansea
FOOTBALL_COMPETITION=ELC
