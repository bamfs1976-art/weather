# Vaisala Xweather API credentials.
# Create a free application at https://account.xweather.com/ to get an ID/secret pair.
# These are read server-side only and never reach the browser.
XWEATHER_CLIENT_ID=your_client_id_here
XWEATHER_CLIENT_SECRET=your_client_secret_here


# Football fixtures (football-data.org) — optional.
# Free tier: https://www.football-data.org/client/register
FOOTBALL_DATA_TOKEN=your_football_data_token_here
# Club to follow, and the competition code it plays in (default ELC = Championship).
# If the club changes division, update FOOTBALL_COMPETITION.
FOOTBALL_TEAM=Swansea
FOOTBALL_COMPETITION=ELC

# Optional. Met Office Weather DataHub, used only for the "Second opinion"
# comparison card. Free plan allows 360 calls a day; the app caches for 30
# minutes, so one location costs roughly 48. Sign up at
# https://datahub.metoffice.gov.uk/ and subscribe to the Site Specific product.
METOFFICE_API_KEY=

# Optional. Met Office DataHub "map images" product — a separate subscription
# and key from the site-specific forecast above. Free plan allows 1000 images
# a day. Falls back to METOFFICE_API_KEY if unset.
METOFFICE_MAP_API_KEY=

# Not used. Met Office DataHub "land observations" was resolved to
# /observation-land/1/{6-character geohash} and then dropped: Xweather's
# observations endpoints already carry real station readings, so it was a
# second source for something the app was not missing. Leave unset.
# METOFFICE_OBS_API_KEY=

# Optional. Met Office DataHub "atmospheric models" — gridded GRIB2 output,
# ordered through the portal. See CLAUDE.md: a poor fit for this app.
METOFFICE_ATMO_API_KEY=

# ---------------------------------------------------------------------------
# The four keyless sources below need no configuration. These base URLs exist
# only so the response handling can be pointed at a local stub in tests, and
# should stay unset in any real environment.
# METOFFICE_WARNINGS_BASE=
# METNO_BASE_URL=
# OPEN_METEO_BASE=
# AURORAWATCH_BASE=
